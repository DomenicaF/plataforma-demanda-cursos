# ------------------------------------------------------------------
# Configuración de la Plataforma de Análisis de Demanda de Cursos
# Copie este archivo a ".env" y ajuste los valores según su entorno.
# Los valores por defecto funcionan con MySQL de Laragon (root sin clave).
# ------------------------------------------------------------------

# Base de datos (SQLAlchemy + PyMySQL)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/plataforma_cursos

# Seguridad (JWT). Cambie SECRET_KEY en producción por un valor aleatorio largo.
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-y-larga
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: orígenes del frontend autorizados (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Usuarios iniciales que crea el script de inicialización (init_db)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123
ANALISTA_EMAIL=analista@demo.com
ANALISTA_PASSWORD=analista123

# Conector real (opcional): tendencias de búsqueda (Google Trends vía pytrends)
# No requiere llave; se activa desde la administración de fuentes.
GOOGLE_TRENDS_ENABLED=true
GOOGLE_TRENDS_GEO=
GOOGLE_TRENDS_LANG=es-419
